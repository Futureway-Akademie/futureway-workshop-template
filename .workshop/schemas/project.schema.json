{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://futureway.example/schemas/workshop/project.schema.json",
  "title": "Futureway Workshop Project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "name",
    "status",
    "workshopType",
    "owner",
    "description",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 1,
      "maxLength": 100
    },
    "name": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": ["not_initialized", "planned", "active", "paused", "completed", "archived"]
    },
    "workshopType": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 100
    },
    "owner": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 2000
    },
    "createdAt": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    },
    "updatedAt": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    }
  }
}

